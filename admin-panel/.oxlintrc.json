{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "jsx-a11y", "nextjs"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "eslint/no-underscore-dangle": ["warn", { "allow": ["_count"] }]
  },
  "ignorePatterns": ["src/generated/**", ".next/**"],
  "overrides": [
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off",
        "eslint/no-shadow": "off"
      }
    }
  ]
}
