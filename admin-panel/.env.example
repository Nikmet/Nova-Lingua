# Postgres (self-hosted на VDS, см. docs/adr/0009). Строка вида:
# postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require&uselibpqcompat=true
# (uselibpqcompat=true нужен из-за самоподписанного сертификата — иначе pg
# трактует require как verify-full и требует доверенный CA)

# Напрямую, без пулера — только для prisma migrate/db push
DIRECT_URL=""

# Через PgBouncer — для приложения и сида
DATABASE_URL=""

# Секрет сессий Auth.js. Сгенерировать: npx auth secret
AUTH_SECRET=""

# Только для `npm run db:seed` — первый Администратор.
SEED_ADMIN_EMAIL="admin@novalingua.ru"
SEED_ADMIN_NAME="Администратор"
SEED_ADMIN_PASSWORD=""
